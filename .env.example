# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Number of proxy hops when deployed behind Railway/Vercel/etc.
# Set to 1 so rate limiting keys on the real client IP (0 = direct).
TRUST_PROXY=0

# Comma-separated list of allowed browser origins (CORS).
# In development the Vite proxy forwards /api same-origin, so this
# mainly matters when the API is deployed separately.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Contact endpoint ────────────────────────────────────
# Max messages stored in the JSON file store (ring buffer)
MAX_MESSAGES=200
# Rate limit: max requests per window per IP
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000

# File where contact messages are persisted (relative to server/).
# Keep this OUT of git — it contains visitor data.
MESSAGES_FILE=./storage/messages.json

# ── Admin dashboard ──────────────────────────────────────
# The private dashboard is protected by this single admin account.
# ALWAYS override these in production with strong values.
ADMIN_EMAIL=mahnoorimranawan22@gmail.com
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h
